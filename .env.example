DATABASE_URL=postgresql://postgres:postgres@db:5432/pantrychef
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantrychef

# Obrigatório: mínimo de 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

AI_API_KEY=sua_chave_aqui
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_TIMEOUT=30
AI_MAX_TENTATIVAS=3
# Orçamento de tokens por resposta (modelos com raciocínio precisam de folga)
AI_MAX_TOKENS=4096

# Limites por IP a cada RATE_LIMIT_JANELA_SEGUNDOS (0 desativa)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_IA=15
RATE_LIMIT_JANELA_SEGUNDOS=60
# Cadastros por IP a cada RATE_LIMIT_CADASTRO_JANELA_SEGUNDOS (0 desativa)
RATE_LIMIT_CADASTRO=10
RATE_LIMIT_CADASTRO_JANELA_SEGUNDOS=3600

# Origens permitidas no CORS (separadas por vírgula); o frontend do compose usa o proxy do nginx
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Popula o catálogo de ingredientes ao subir a API
SEED_INGREDIENTES=true
